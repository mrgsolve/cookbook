[ plugin ] evtools

[ set ] outvars = "CP"

[ param ] 

CL = 1
V = 32
KA = 2

DOSE = 100
INTERVAL = 24
OVER = 2
END = 240

[ pkmodel ] advan = 2

[ event ] 

if(TIME > END) return;

if(NEWIND <=1) { 
  double nextdose = 0;
}

if(evt::near(TIME, nextdose)) {
  evt::infuse(self, DOSE, 2, DOSE/OVER); 
  nextdose = nextdose + INTERVAL;
}

[ error ]  capture CP = A2/V;
